# CyberShield 360 Environment Configuration
# Copy this file to .env and update values

SECRET_KEY=your-super-secret-key-change-this
JWT_SECRET_KEY=your-jwt-secret-key-change-this

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/cybershield360
MONGO_DB_NAME=cybershield360

# Application environment: development locally, production on Render
APP_ENV=development

# Optional CORS allowlist (comma-separated). Same-origin Render requests need no extra origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local admin account. Set unique values in production; never commit real credentials.
ADMIN_EMAIL=admin@cybershield360.com
ADMIN_PASSWORD=Admin@123
